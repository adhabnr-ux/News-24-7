# News247 settings for your own server: the same values you had under Environment on Render.
# setup.sh copies this to .env and asks for the important ones; edit .env any time, then run
#   cd /opt/news247/deploy/vps && docker compose up -d
#
# Keep DASHBOARD_TOKEN exactly as it was on Render: it also derives the push key, so phones that
# subscribed on Render keep getting alerts from the new server.
DASHBOARD_TOKEN=
CONTACT_EMAIL=
TIMEZONE=America/New_York

# The new address, set by setup.sh (https://<your-ip>.sslip.io or https://your.domain)
PUBLIC_URL=

# Optional: a Postgres URL (Neon, Supabase) if you used one on Render. On your own server the disk
# is permanent, so it's no longer needed, but setting it carries phones and settings across.
STATE_DB=

# Optional: Alpaca keys (options tape, news, the paper mirror)
ALPACA_KEY=
ALPACA_SECRET=

# Optional: WhatsApp through Meta's Cloud API (leave empty if you don't use it)
WHATSAPP_TO=
WHATSAPP_CLOUD_ENABLED=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_ID=
WHATSAPP_CLOUD_WABA_ID=
WHATSAPP_CLOUD_APP_SECRET=
WHATSAPP_CLOUD_VERIFY_TOKEN=
